# Copy to backend/.env and fill in. NEVER commit .env.
# Keep comments on their own lines: "KEY=   # note" would make "# note" the value.

# ---------- providers ("mock" runs offline with no keys) ----------
# LLM: gemini | openai | mock
GD_LLM=gemini
# TTS: edge | gemini | elevenlabs | mock
GD_TTS=edge
# used automatically when the primary TTS fails
GD_TTS_FALLBACK=gemini
# ASR for audio uploads: groq | faster_whisper | mock (offline: cuts at silences, placeholder text)
GD_ASR=groq
GD_LLM_JUDGE=1
# background music for audio uploads: auto (Demucs if installed, else centre-channel) | demucs | center | none
GD_SEPARATION=auto
# how far the music dips (dB) while someone speaks
GD_DUCK_DB=6

# Gemini key from aistudio.google.com
GEMINI_API_KEY=
# writes the translations; run scripts/check_setup.py to see which models your key can use
GEMINI_MODEL=gemini-3.5-flash
# QA judge: a cheaper model with its own quota
GEMINI_JUDGE_MODEL=gemini-flash-lite-latest
# used automatically when the main model is overloaded or out of quota
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# max LLM requests per minute across all threads (free tier is low)
GD_LLM_RPM=8

# Groq key from console.groq.com (only needed for audio uploads)
GROQ_API_KEY=
# optional premium voices
ELEVENLABS_API_KEY=
# optional: Qwen or any OpenAI-compatible model
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3-235b-a22b

# Unit prices in USD for the cost dashboard - set them to your provider's current prices
PRICE_LLM_IN_1M=0.30
PRICE_LLM_OUT_1M=2.50
PRICE_TTS_1K=0
PRICE_ASR_MIN=0

# ---------- infrastructure (leave empty locally) ----------
# Neon Postgres, e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
# Upstash Redis, e.g. rediss://default:pass@host:6379
REDIS_URL=
# Cloudflare R2: bucket, endpoint https://<account_id>.r2.cloudflarestorage.com, and API token
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---------- public demo guardrails ----------
# long random string: bypasses limits and publishes gallery episodes
ADMIN_TOKEN=
# random string used to anonymise visitor IPs
IP_SALT=
DAILY_BUDGET_USD=1.0
JOBS_PER_IP_PER_DAY=3
MAX_LANGS_PER_JOB=3
MAX_AUDIO_SECONDS=180
